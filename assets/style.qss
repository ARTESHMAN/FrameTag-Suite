/* ==========================================================================
   Modern Pro Dark Workstation Theme (Zinc / Slate + Cobalt Accent)
   ========================================================================== */

/* --- Base & Typography --- */
QWidget {
    background-color: #18181b;
    color: #e4e4e7;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Inter", sans-serif;
    font-size: 13px;
    selection-background-color: #3b82f6;
    selection-color: #ffffff;
    outline: none;
}

/* --- Main Window, Menus & Toolbars --- */
QMainWindow {
    background-color: #121214;
}

QMainWindow::separator {
    background: #27272a;
    width: 2px;
    height: 2px;
}

QMenuBar {
    background-color: #18181b;
    border-bottom: 1px solid #27272a;
    padding: 3px 6px;
    color: #a1a1aa;
}

QMenuBar::item {
    background: transparent;
    padding: 4px 10px;
    border-radius: 4px;
}

QMenuBar::item:selected {
    background-color: #27272a;
    color: #ffffff;
}

QMenu {
    background-color: #1f1f23;
    border: 1px solid #3f3f46;
    border-radius: 6px;
    padding: 4px;
}

QMenu::item {
    padding: 6px 24px 6px 12px;
    border-radius: 4px;
    color: #e4e4e7;
}

QMenu::item:selected {
    background-color: #3b82f6;
    color: #ffffff;
}

QMenu::separator {
    height: 1px;
    background-color: #27272a;
    margin: 4px 8px;
}

QToolBar {
    background-color: #18181b;
    border-bottom: 1px solid #27272a;
    spacing: 4px;
    padding: 4px;
}

/* --- Dock Widgets & Panels --- */
QDockWidget {
    titlebar-close-icon: none;
    titlebar-normal-icon: none;
    font-weight: 600;
}

QDockWidget::title {
    background-color: #202024;
    padding: 7px 10px;
    border-bottom: 1px solid #2e2e33;
    color: #a1a1aa;
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.5px;
}

/* --- Buttons --- */
QPushButton {
    background-color: #27272a;
    border: 1px solid #3f3f46;
    border-radius: 5px;
    padding: 6px 14px;
    color: #fafafa;
    font-weight: 500;
}

QPushButton:hover {
    background-color: #323238;
    border-color: #52525b;
}

QPushButton:pressed {
    background-color: #18181b;
}

QPushButton:disabled {
    background-color: #1c1c1f;
    border-color: #27272a;
    color: #52525b;
}

/* Primary Highlight Action (e.g., Run Model / Export) */
QPushButton#primaryButton {
    background-color: #2563eb;
    border: 1px solid #3b82f6;
    color: #ffffff;
}

QPushButton#primaryButton:hover {
    background-color: #1d4ed8;
}

QPushButton#primaryButton:pressed {
    background-color: #1e40af;
}

/* --- Inputs, Combos & Spinners --- */
QLineEdit, QComboBox, QSpinBox, QDoubleSpinBox {
    background-color: #202024;
    border: 1px solid #3f3f46;
    border-radius: 5px;
    padding: 5px 8px;
    color: #f4f4f5;
}

QLineEdit:focus, QComboBox:focus, QSpinBox:focus, QDoubleSpinBox:focus {
    border: 1px solid #3b82f6;
    background-color: #27272a;
}

QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: top right;
    width: 20px;
    border-left: none;
}

QComboBox QAbstractItemView {
    background-color: #1f1f23;
    border: 1px solid #3f3f46;
    border-radius: 6px;
    selection-background-color: #3b82f6;
    padding: 4px;
}

/* --- Lists, Trees & Tables (Tracks, Classes, Objects) --- */
QListWidget, QTreeWidget, QTableWidget {
    background-color: #18181b;
    border: 1px solid #27272a;
    border-radius: 6px;
    padding: 4px;
    color: #e4e4e7;
    gridline-color: #27272a;
}

QListWidget::item, QTreeWidget::item, QTableWidget::item {
    padding: 6px 8px;
    border-radius: 4px;
}

QListWidget::item:hover, QTreeWidget::item:hover, QTableWidget::item:hover {
    background-color: #27272a;
}

QListWidget::item:selected, QTreeWidget::item:selected, QTableWidget::item:selected {
    background-color: #1e3a8a;
    color: #93c5fd;
}

QHeaderView::section {
    background-color: #202024;
    color: #a1a1aa;
    padding: 6px;
    border: none;
    border-right: 1px solid #27272a;
    border-bottom: 1px solid #27272a;
    font-size: 11px;
    font-weight: bold;
}

/* --- Video Scrubber & Sliders --- */
QSlider::groove:horizontal {
    height: 4px;
    background: #3f3f46;
    border-radius: 2px;
}

QSlider::sub-page:horizontal {
    background: #3b82f6;
    border-radius: 2px;
}

QSlider::handle:horizontal {
    background: #ffffff;
    border: 2px solid #3b82f6;
    width: 14px;
    margin-top: -5px;
    margin-bottom: -5px;
    border-radius: 7px;
}

QSlider::handle:horizontal:hover {
    background: #bfdbfe;
}

/* --- Scrollbars --- */
QScrollBar:vertical {
    background: transparent;
    width: 8px;
    margin: 0px;
}

QScrollBar::handle:vertical {
    background: #3f3f46;
    min-height: 24px;
    border-radius: 4px;
}

QScrollBar::handle:vertical:hover {
    background: #52525b;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical,
QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical {
    height: 0px;
    background: transparent;
}

QScrollBar:horizontal {
    background: transparent;
    height: 8px;
    margin: 0px;
}

QScrollBar::handle:horizontal {
    background: #3f3f46;
    min-width: 24px;
    border-radius: 4px;
}

QScrollBar::handle:horizontal:hover {
    background: #52525b;
}

QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal,
QScrollBar::add-page:horizontal, QScrollBar::sub-page:horizontal {
    width: 0px;
    background: transparent;
}

/* --- Tabs & Status Bar --- */
QTabWidget::pane {
    border: 1px solid #27272a;
    background: #18181b;
}

QTabBar::tab {
    background: #202024;
    color: #a1a1aa;
    padding: 7px 14px;
    border-top-left-radius: 5px;
    border-top-right-radius: 5px;
    margin-right: 2px;
}

QTabBar::tab:selected {
    background: #18181b;
    color: #ffffff;
    border-bottom: 2px solid #3b82f6;
}

QStatusBar {
    background-color: #121214;
    border-top: 1px solid #27272a;
    color: #71717a;
    font-size: 11px;
}